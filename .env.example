# ==============================================================================
# ZWANTUM COMMERCE ENGINE - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env in each application or root as required.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zwantum_commerce?schema=public
# Direct connection URL for migrations when using PgBouncer / connection pooling
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zwantum_commerce?schema=public

# ------------------------------------------------------------------------------
# 2. COMMERCE API (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STORE_ID=store_default_in

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECRETS (JWT / Sessions)
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace-with-another-secure-random-secret-key
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_SESSION_SECRET=replace-with-admin-session-secret

# ------------------------------------------------------------------------------
# 4. STOREFRONT APPLICATION (apps/storefront)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_STORE_NAME="Zwantum Commerce"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# ------------------------------------------------------------------------------
# 5. ADMIN APPLICATION (apps/admin)
# ------------------------------------------------------------------------------
PORT=3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE (S3-Compatible / Cloudinary / Local)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local # local | s3 | cloudinary
S3_BUCKET=zwantum-commerce-media
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_URL=

# ------------------------------------------------------------------------------
# 7. PAYMENTS (India-First & Universal)
# ------------------------------------------------------------------------------
# Razorpay (UPI, Netbanking, Cards, Wallets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (UPI, Cards, Netbanking)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST # TEST | PRODUCTION

# Cash on Delivery (COD) Settings
COD_ENABLED=true
COD_ADDITIONAL_FEE_PAISE=0 # In paise (e.g., 5000 = ₹50.00)
COD_MAX_ORDER_AMOUNT_PAISE=500000 # In paise (e.g., ₹5,000.00 max limit)

# ------------------------------------------------------------------------------
# 8. SHIPPING & LOGISTICS (India-First Logistics)
# ------------------------------------------------------------------------------
# Shiprocket (Courier Aggregator - India)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Store Origin Shipping PIN Code (Used for pickup and rate calculation)
STORE_ORIGIN_PINCODE=110001
STORE_ORIGIN_STATE=Delhi
STORE_ORIGIN_CITY=New Delhi

# ------------------------------------------------------------------------------
# 9. TAXATION (Indian GST & HSN Configuration)
# ------------------------------------------------------------------------------
GST_ENABLED=true
STORE_GSTIN=07AAAAA0000A1Z5
STORE_STATE_CODE=07 # 2-digit Indian GST State Code (e.g., 07 for Delhi, 27 for Maharashtra)
DEFAULT_HSN_CODE=61091000

